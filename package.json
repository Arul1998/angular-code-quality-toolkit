{
  "name": "angular-code-quality-toolkit",
  "displayName": "Angular Code Quality Toolkit",
  "description": "Run ESLint, stylelint, knip and more on your Angular project from one sidebar: every finding lands in the Problems panel, with one-click install, auto-fix and quick fixes.",
  "version": "0.8.0",
  "publisher": "arul1998",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arul1998/angular-code-quality-toolkit"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "angular",
    "code quality",
    "eslint",
    "stylelint",
    "ts-prune",
    "depcheck",
    "cleanup",
    "refactor",
    "knip",
    "madge",
    "circular dependencies",
    "angular-eslint"
  ],
  "homepage": "https://github.com/Arul1998/angular-code-quality-toolkit#readme",
  "bugs": {
    "url": "https://github.com/Arul1998/angular-code-quality-toolkit/issues"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:angular.json",
    "workspaceContains:nx.json"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "This extension runs command-line tools (depcheck, ts-prune, ESLint, stylelint) in your workspace, which requires a real filesystem. It is unavailable in virtual workspaces such as VS Code for the Web (vscode.dev / github.dev)."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "angularCodeQualityToolkit.runAllChecks",
        "title": "Run all checks",
        "category": "Angular Code Quality",
        "icon": "$(run-all)"
      },
      {
        "command": "angularCodeQualityToolkit.setupTools",
        "title": "Install / check tools…",
        "category": "Angular Code Quality",
        "icon": "$(cloud-download)"
      },
      {
        "command": "angularCodeQualityToolkit.runEslint",
        "title": "Run ESLint",
        "category": "Angular Code Quality"
      },
      {
        "command": "angularCodeQualityToolkit.runStylelint",
        "title": "Run stylelint",
        "category": "Angular Code Quality"
      },
      {
        "command": "angularCodeQualityToolkit.runKnip",
        "title": "Run knip (unused files, exports, dependencies)",
        "category": "Angular Code Quality"
      },
      {
        "command": "angularCodeQualityToolkit.runTemplateLint",
        "title": "Lint Angular templates (.html)",
        "category": "Angular Code Quality"
      },
      {
        "command": "angularCodeQualityToolkit.runMadge",
        "title": "Find circular dependencies (madge)",
        "category": "Angular Code Quality"
      },
      {
        "command": "angularCodeQualityToolkit.runTsPrune",
        "title": "Run ts-prune",
        "category": "Angular Code Quality"
      },
      {
        "command": "angularCodeQualityToolkit.runDepcheck",
        "title": "Run depcheck",
        "category": "Angular Code Quality"
      },
      {
        "command": "angularCodeQualityToolkit.fixEslint",
        "title": "Fix ESLint problems (--fix)",
        "category": "Angular Code Quality"
      },
      {
        "command": "angularCodeQualityToolkit.fixStylelint",
        "title": "Fix stylelint problems (--fix)",
        "category": "Angular Code Quality"
      },
      {
        "command": "angularCodeQualityToolkit.exportReport",
        "title": "Export report (JSON)",
        "category": "Angular Code Quality",
        "icon": "$(json)"
      },
      {
        "command": "angularCodeQualityToolkit.addEslintToAngular",
        "title": "Add ESLint to Angular project",
        "category": "Angular Code Quality"
      },
      {
        "command": "angularCodeQualityToolkit.selectProject",
        "title": "Select Angular project",
        "category": "Angular Code Quality",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "angularCodeQualityToolkit.clearDiagnostics",
        "title": "Clear results",
        "category": "Angular Code Quality",
        "icon": "$(clear-all)"
      },
      {
        "command": "angularCodeQualityToolkit.openSettings",
        "title": "Open settings",
        "category": "Angular Code Quality",
        "icon": "$(gear)"
      },
      {
        "command": "angularCodeQualityToolkit.openWalkthrough",
        "title": "Get started",
        "category": "Angular Code Quality",
        "icon": "$(book)"
      },
      {
        "command": "angularCodeQualityToolkit.refreshTools",
        "title": "Refresh tools",
        "category": "Angular Code Quality",
        "icon": "$(refresh)"
      },
      {
        "command": "angularCodeQualityToolkit.runTool",
        "title": "Run",
        "category": "Angular Code Quality",
        "icon": "$(play)"
      },
      {
        "command": "angularCodeQualityToolkit.fixTool",
        "title": "Fix auto-fixable problems (--fix)",
        "category": "Angular Code Quality",
        "icon": "$(wrench)"
      },
      {
        "command": "angularCodeQualityToolkit.installTool",
        "title": "Install",
        "category": "Angular Code Quality",
        "icon": "$(cloud-download)"
      },
      {
        "command": "angularCodeQualityToolkit.removeUnusedDependency",
        "title": "Remove unused dependency",
        "category": "Angular Code Quality"
      },
      {
        "command": "angularCodeQualityToolkit.removeUnusedExport",
        "title": "Remove export keyword",
        "category": "Angular Code Quality"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "angularCodeQualityToolkit.runAllChecks",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.setupTools",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.runEslint",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.runStylelint",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.runKnip",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.runTemplateLint",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.runMadge",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.runTsPrune",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.runDepcheck",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.fixEslint",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.fixStylelint",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.exportReport",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.addEslintToAngular",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.selectProject",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.clearDiagnostics",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "angularCodeQualityToolkit.refreshTools",
          "when": "false"
        },
        {
          "command": "angularCodeQualityToolkit.runTool",
          "when": "false"
        },
        {
          "command": "angularCodeQualityToolkit.fixTool",
          "when": "false"
        },
        {
          "command": "angularCodeQualityToolkit.installTool",
          "when": "false"
        },
        {
          "command": "angularCodeQualityToolkit.removeUnusedDependency",
          "when": "false"
        },
        {
          "command": "angularCodeQualityToolkit.removeUnusedExport",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "angularCodeQualityToolkit.runAllChecks",
          "when": "view == angularCodeQuality.tools",
          "group": "navigation@1"
        },
        {
          "command": "angularCodeQualityToolkit.refreshTools",
          "when": "view == angularCodeQuality.tools",
          "group": "navigation@2"
        },
        {
          "command": "angularCodeQualityToolkit.clearDiagnostics",
          "when": "view == angularCodeQuality.tools",
          "group": "navigation@3"
        },
        {
          "command": "angularCodeQualityToolkit.setupTools",
          "when": "view == angularCodeQuality.tools",
          "group": "1_setup@1"
        },
        {
          "command": "angularCodeQualityToolkit.selectProject",
          "when": "view == angularCodeQuality.tools",
          "group": "1_setup@2"
        },
        {
          "command": "angularCodeQualityToolkit.exportReport",
          "when": "view == angularCodeQuality.tools",
          "group": "2_report@1"
        },
        {
          "command": "angularCodeQualityToolkit.openSettings",
          "when": "view == angularCodeQuality.tools",
          "group": "3_help@1"
        },
        {
          "command": "angularCodeQualityToolkit.openWalkthrough",
          "when": "view == angularCodeQuality.tools",
          "group": "3_help@2"
        }
      ],
      "view/item/context": [
        {
          "command": "angularCodeQualityToolkit.fixTool",
          "when": "view == angularCodeQuality.tools && viewItem =~ /-fixable$/",
          "group": "inline@1"
        },
        {
          "command": "angularCodeQualityToolkit.runTool",
          "when": "view == angularCodeQuality.tools && viewItem =~ /^tool-ready/ && viewItem != tool-ready-fixable-running && viewItem != tool-ready-running",
          "group": "inline@2"
        },
        {
          "command": "angularCodeQualityToolkit.installTool",
          "when": "view == angularCodeQuality.tools && viewItem =~ /^tool-missing/",
          "group": "inline@1"
        },
        {
          "command": "angularCodeQualityToolkit.runTool",
          "when": "view == angularCodeQuality.tools && viewItem =~ /^tool-ready/",
          "group": "1_run@1"
        },
        {
          "command": "angularCodeQualityToolkit.fixTool",
          "when": "view == angularCodeQuality.tools && viewItem =~ /fixable/",
          "group": "1_run@2"
        },
        {
          "command": "angularCodeQualityToolkit.installTool",
          "when": "view == angularCodeQuality.tools && viewItem =~ /^tool-missing/",
          "group": "1_run@1"
        }
      ]
    },
    "configuration": {
      "title": "Angular Code Quality Toolkit",
      "properties": {
        "angularCodeQuality.checks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "eslint",
              "stylelint",
              "knip",
              "angular-template",
              "madge",
              "ts-prune",
              "depcheck"
            ]
          },
          "uniqueItems": true,
          "default": [],
          "markdownDescription": "Tools that **Run all checks**, **Export report** and run-on-save use. Leave empty for automatic: every installed tool (ESLint, stylelint, knip, madge), with knip replacing ts-prune + depcheck when it is installed. Template lint (`angular-template`) runs only when listed here, since `ng lint` usually covers templates already."
        },
        "angularCodeQuality.packageManager": {
          "type": "string",
          "enum": [
            "auto",
            "npm",
            "yarn",
            "pnpm",
            "bun"
          ],
          "default": "auto",
          "description": "Package manager used to run tools and scripts. \"auto\" detects it from the lockfile in the workspace root (pnpm-lock.yaml, yarn.lock, bun.lockb, package-lock.json)."
        },
        "angularCodeQuality.tsPrune.tsconfigPath": {
          "type": "string",
          "default": "tsconfig.app.json",
          "description": "Path (relative to the workspace root) to the tsconfig ts-prune should use. Falls back to running ts-prune without a project file if the file is missing."
        },
        "angularCodeQuality.stylelint.globs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "src/**/*.scss",
            "src/**/*.css"
          ],
          "description": "Glob patterns stylelint should lint when no \"lint:styles\" or \"stylelint\" npm script is defined."
        },
        "angularCodeQuality.template.globs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "src/**/*.html"
          ],
          "description": "Glob patterns for \"Lint Angular templates\" (runs ESLint over your .html templates via @angular-eslint/template). In a multi-project workspace, this defaults to the selected project's source root unless set explicitly."
        },
        "angularCodeQuality.eslint.useJsonFormat": {
          "type": "boolean",
          "default": true,
          "description": "Request JSON output from the lint script (npm run lint -- --format json) for more reliable parsing. Disable if your lint script does not support --format."
        },
        "angularCodeQuality.stylelint.useJsonFormat": {
          "type": "boolean",
          "default": true,
          "description": "Request JSON output from stylelint (--formatter json) for more reliable parsing. Disable if your setup does not support it."
        },
        "angularCodeQuality.depcheck.ignoreAngularImplicit": {
          "type": "boolean",
          "default": true,
          "description": "Hide depcheck \"unused dependency\" results for packages Angular uses implicitly (@angular/*, zone.js, rxjs, tslib, typescript, karma/jasmine, and builders referenced in angular.json), which are otherwise false positives."
        },
        "angularCodeQuality.depcheck.ignores": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional package-name patterns to hide from depcheck \"unused dependency\" results. \"*\" is a wildcard (e.g. \"@my-scope/*\")."
        },
        "angularCodeQuality.revealOutputOnRun": {
          "type": "boolean",
          "default": false,
          "description": "Reveal the Angular Code Quality output channel automatically each time a command runs. Findings appear in the Problems panel; enable this only if you want to watch the raw tool logs."
        },
        "angularCodeQuality.runOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically re-run the relevant checks when you save a file, updating the Problems panel in the background (no notifications). Saving a .ts file re-runs ESLint and ts-prune; a .html file re-runs the Angular template lint; a .css/.scss file re-runs stylelint; package.json re-runs depcheck. Runs are debounced so rapid saves trigger a single run."
        },
        "angularCodeQuality.runOnActivation": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run all checks once when the workspace opens, so the Problems panel is populated without running a command by hand. Runs quietly in the background (a status-bar spinner, no popups). Off by default."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "angularCodeQuality",
          "title": "Angular Code Quality",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "angularCodeQuality": [
        {
          "id": "angularCodeQuality.tools",
          "name": "Tools",
          "contextualTitle": "Angular Code Quality"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "angularCodeQuality.tools",
        "contents": "Open your Angular project folder to check its code quality.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with Angular Code Quality",
        "description": "Install the tools, run your first scan, and fix what it finds.",
        "steps": [
          {
            "id": "install",
            "title": "Install the tools",
            "description": "The extension runs the tools installed in your project. Pick the recommended ones (ESLint, stylelint, knip) and they are installed as devDependencies.\n[Install / check tools](command:angularCodeQualityToolkit.setupTools)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onCommand:angularCodeQualityToolkit.setupTools"
            ]
          },
          {
            "id": "runAll",
            "title": "Run all checks",
            "description": "One command runs every installed tool and puts each finding in the Problems panel. Click one to jump to the line.\n[Run all checks](command:angularCodeQualityToolkit.runAllChecks)",
            "media": {
              "markdown": "media/walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:angularCodeQualityToolkit.runAllChecks"
            ]
          },
          {
            "id": "sidebar",
            "title": "Use the Code Quality view",
            "description": "The Code Quality icon in the Activity Bar lists each tool with its live status. Run, fix or install a tool with one click.\n[Open the Code Quality view](command:workbench.view.extension.angularCodeQuality)",
            "media": {
              "markdown": "media/walkthrough/sidebar.md"
            },
            "completionEvents": [
              "onView:angularCodeQuality.tools"
            ]
          },
          {
            "id": "fix",
            "title": "Fix problems",
            "description": "Auto-fix lint and style issues, or use the lightbulb (Ctrl+. / Cmd+.) on a finding for a quick fix.\n[Fix ESLint problems](command:angularCodeQualityToolkit.fixEslint)",
            "media": {
              "markdown": "media/walkthrough/fix.md"
            },
            "completionEvents": [
              "onCommand:angularCodeQualityToolkit.fixEslint",
              "onCommand:angularCodeQualityToolkit.fixTool"
            ]
          },
          {
            "id": "runOnSave",
            "title": "Keep results fresh",
            "description": "Turn on run-on-save so the relevant checks re-run quietly whenever you save a file.\n[Open the setting](command:workbench.action.openSettings?%5B%22angularCodeQuality.runOnSave%22%5D)",
            "media": {
              "markdown": "media/walkthrough/run-on-save.md"
            },
            "completionEvents": [
              "onSettingChanged:angularCodeQuality.runOnSave"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "package": "npm run check-types && node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "compile-tests": "tsc -p ./",
    "lint": "eslint \"src/**/*.ts\"",
    "pretest": "npm run compile-tests",
    "test": "cd out && node --test",
    "pretest:integration": "npm run compile && npm run compile-tests",
    "test:integration": "vscode-test",
    "vsix": "vsce package -o angular-code-quality-toolkit.vsix",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish angular-code-quality-toolkit.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.0.0",
    "mocha": "^10.8.2",
    "ovsx": "^1.1.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0"
  }
}
